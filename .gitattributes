# Files that run on Linux (shell, Docker, make) or get built there must keep LF
# endings even in a Windows checkout with core.autocrlf=true: a CRLF build.sh
# fails with "\r: command not found" and a CRLF Dockerfile bakes the \r into
# RUN lines.
*.sh        text eol=lf
Dockerfile* text eol=lf
Makefile    text eol=lf
*.c         text eol=lf
*.ld        text eol=lf
*.asm       text eol=lf

# Committed build artifacts embedded with go:embed (pkg/trampoline/trampoline.bin,
# pkg/preload/libepochd_preload.so); never touch their bytes.
*.so        binary
*.bin       binary
*.elf       binary
