# Builds trampoline.bin from trampoline.c + link.ld and regenerates everything
# that has to agree with it. Run build.sh rather than using this directly; it
# exports the artifacts one level up, into pkg/trampoline/.
#
# Outputs (committed, so `go build` needs no C toolchain):
#   trampoline.bin          the flat position-independent blob Go embeds
#   trampoline.elf          the linked ELF; tests read its symbols to prove the
#                           offsets below describe the blob
#   offsets_generated.go    entry/state offsets, read from the ELF's symbols
#   trampoline.src.sha256   hash of the sources, so a test notices a source edit
#                           that was never rebuilt
FROM ubuntu:22.04 AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libc6-dev binutils \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY trampoline.c link.ld ./

# -fPIC -fno-plt          RIP-relative data access, no GOT/PLT indirection
# -ffreestanding          no libc assumptions; -fno-stack-protector, -U_FORTIFY_SOURCE
#                         and -fcf-protection=none drop distro hardening that would
#                         reference libc symbols or prepend endbr64 to every entry
# -mno-red-zone           the hooks run on the caller's stack
RUN set -eu; \
    gcc -c -std=gnu11 -O2 -Wall -Wextra -Werror -fPIC -fno-plt -ffreestanding \
        -fno-stack-protector -fno-asynchronous-unwind-tables -fomit-frame-pointer \
        -mno-red-zone -fcf-protection=none -U_FORTIFY_SOURCE -fno-ident \
        -o trampoline.o trampoline.c; \
    ld -T link.ld -o trampoline.elf trampoline.o; \
    objcopy -O binary trampoline.elf trampoline.bin

# The blob is mapped at an address chosen at run time, so it must contain no
# absolute address, no call out of itself, and no GOT/PLT. Fail the build
# rather than ship a blob that only works by accident.
RUN set -eu; \
    bad=$(readelf -r -W trampoline.o | awk '/R_X86_64_/ {print $3}' | sort -u | grep -v -E '^R_X86_64_(PC32|PLT32)$' || true); \
    [ -z "$bad" ] || { echo "non-PC-relative relocations in trampoline.o: $bad"; exit 1; }; \
    ! readelf -S -W trampoline.elf | grep -E '\.(got|plt)' || { echo "GOT/PLT section present"; exit 1; }; \
    ! objdump -d -M intel trampoline.elf | grep -E '\bcall\b' || { echo "unexpected call instruction"; exit 1; }

# Read the offsets back out of the linked ELF instead of counting bytes.
RUN set -eu; \
    off() { printf '%d' "0x$(nm trampoline.elf | awk -v n="$1" '$3 == n {print $1}')"; }; \
    cgt=$(off clock_gettime_entry); gtod=$(off gettimeofday_entry); tm=$(off time_entry); st=$(off g_state); \
    size=$(wc -c < trampoline.bin); \
    [ "$cgt" -eq 0 ] || { echo "clock_gettime_entry must be at offset 0, got $cgt"; exit 1; }; \
    [ "$cgt" -lt "$gtod" ] && [ "$gtod" -lt "$tm" ] && [ "$tm" -lt "$st" ] || { echo "stubs out of order"; exit 1; }; \
    [ "$st" -eq $((size - 32)) ] || { echo "g_state is not the last 32 bytes (state=$st size=$size)"; exit 1; }; \
    mkdir /out && cp trampoline.bin trampoline.elf /out/ && sha256sum trampoline.c link.ld > /out/trampoline.src.sha256; \
    { \
      echo '// Code generated by build.sh from the linked trampoline.elf. DO NOT EDIT.'; \
      echo; echo '//go:build linux'; echo; echo 'package trampoline'; echo; \
      echo '// Entry offsets locate each hook within Payload. inject.go computes the JMP rel32'; \
      echo '// target for a vDSO function as (trampoline page base) + (its EntryOffset).'; \
      echo 'const ('; \
      echo "	ClockGettimeEntryOffset = $cgt"; \
      echo "	GettimeofdayEntryOffset = $gtod"; \
      echo "	TimeEntryOffset         = $tm"; \
      echo; echo '	// StateOffset is the byte offset of the state struct within Payload.'; \
      echo "	StateOffset = $st"; \
      echo ')'; \
    } > /out/offsets_generated.go; \
    echo "--- blob: $size bytes; entries $cgt/$gtod/$tm; state at $st ---"

FROM scratch AS artifact
COPY --from=build /out/ /
